{
  "manifest_version": "0.3",
  "name": "discord-rpc-mcp",
  "display_name": "Discord RPC MCP",
  "version": "0.1.0",
  "description": "Read Discord channels, follow new messages and control calls from your AI assistant.",
  "author": { "name": "AKAI", "url": "https://ver1000000.com" },
  "repository": { "type": "git", "url": "https://github.com/ver-1000000/discord-rpc-mcp" },
  "homepage": "https://github.com/ver-1000000/discord-rpc-mcp",
  "icon": "assets/icon.png",
  "license": "MIT",
  "privacy_policies": ["https://discord.com/privacy"],
  "tools_generated": true,
  "compatibility": { "platforms": ["linux", "darwin", "win32"] },
  "server": {
    "type": "binary",
    "entry_point": "server/launch.sh",
    "mcp_config": {
      "command": "${__dirname}/server/launch.sh",
      "args": ["--env-file", "${user_config.env_file}"],
      "platform_overrides": {
        "win32": { "command": "${__dirname}/server/windows-x64/discord-rpc-mcp.exe" }
      }
    }
  },
  "user_config": {
    "env_file": {
      "type": "file",
      "title": "Configuration file",
      "description": "Select the .env file used for discord-rpc-mcp login. Complete the README setup first and keep Discord running.",
      "required": true
    }
  }
}
