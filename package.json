{
  "name": "discord-rpc-mcp",
  "version": "0.1.0",
  "description": "A local MCP bridge for Discord desktop RPC.",
  "type": "module",
  "license": "MIT",
  "author": "AKAI",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "discord-rpc-mcp": "src/cli.js"
  },
  "files": [
    "src",
    "assets/icon.svg",
    ".env.example",
    "README.md",
    "README.ja.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test",
    "check": "node --check src/cli.js && npm test",
    "build:binary": "bun scripts/build-binary.js && node scripts/prepare-binary.js",
    "test:binary": "node scripts/smoke-binary.js",
    "pack:mcpb": "node scripts/package-mcpb.js",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@jellybrick/dbus-next": "^0.11.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^2.0.0",
    "zod": "^4.5.4"
  },
  "overrides": {
    "@anthropic-ai/mcpb": { "tmp": "0.2.7" }
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "bun": "^1.4.2"
  }
}
